# Copy the lines you need into backend/.env  (never commit backend/.env)
#
# ---------------------------------------------------------------------------
# AI PROVIDERS - always tried in this exact order:
#   1. Hugging Face (primary)  2. Cloudflare  3. Groq  4. Google  5. OpenRouter
# A provider with no key is skipped. If one fails, the next answers automatically.
# *_MODEL may hold one model or a comma-separated list (tried in order). Leave a
# *_MODEL line out to use the built-in defaults.
# ---------------------------------------------------------------------------

# 1) Hugging Face - https://huggingface.co/settings/tokens
#    (your existing API_KEY= and MODEL= lines still work; these names are preferred)
HF_API_KEY=
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct,Qwen/Qwen3-8B,meta-llama/Llama-3.1-8B-Instruct

# 2) Cloudflare Workers AI - needs BOTH the account id and an API token with Workers AI access
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
# CLOUDFLARE_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/google/gemma-4-26b-a4b-it

# 3) Groq - https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile,llama-3.1-8b-instant

# 4) Google Gemini - https://aistudio.google.com/apikey  (NOT the Google sign-in client id)
GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.8-flash,gemini-flash-latest

# 5) OpenRouter - https://openrouter.ai/keys   (free model names change often: check openrouter.ai/models)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free,google/gemma-4-31b-it:free


# --- Photo reports: AI image analysis (optional) ---
# Optional durable private photo storage. Copy these from Cloudinary Console > Settings >
# API Keys, then configure them as secrets in Render. Uploads use authenticated delivery.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Uses the same keys as above. Vision models are tried in the SAME order as the text chain:
#   Hugging Face > Cloudflare > Groq > Google > OpenRouter
#
# You normally do NOT need to set any *_VISION_MODEL: good defaults are built in, and when a
# model has been retired the app asks the provider which models it offers now.
# Model names change often (gemini-2.5-flash, llama-4-scout and the Qwen2.5-VL names used in
# older examples no longer work). If you set one yourself it is tried FIRST, then the defaults.
# If you copied the old example lines into backend/.env or Render, delete them.
# HF_VISION_MODEL=
# CLOUDFLARE_VISION_MODEL=@cf/google/gemma-4-26b-a4b-it,@cf/meta/llama-4-scout-17b-16e-instruct
# GROQ_VISION_MODEL=qwen/qwen3.8-27b,qwen/qwen3.6-27b
# GOOGLE_VISION_MODEL=gemini-3.8-flash,gemini-flash-latest
# OPENROUTER_VISION_MODEL=openrouter/free
# Unsent photo drafts are deleted after this many hours (default 24)
# PHOTO_DRAFT_HOURS=24
