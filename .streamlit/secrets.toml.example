# Copy these into Streamlit Cloud: App -> Settings -> Secrets.
# NEVER commit a real secrets.toml to GitHub.

# ---- same values you use on Render ----
DATABASE_URL = "example"
MODEL = "Qwen/Qwen2.5-7B-Instruct,Qwen/Qwen3-8B,meta-llama/Llama-3.1-8B-Instruct"
HF_TOKEN = "your_huggingface_token_here"
ADMIN_EMAILS = "admin1@nemsu.edu.ph,admin2@nemsu.edu.ph"
ALLOWED_EMAIL_DOMAIN = "nemsu.edu.ph"

# ---- Google login (Streamlit's built-in st.login) ----
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "put-a-long-random-string-here"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account" }
